{
	"name": "site",
	"main": "src/worker.tsx",
	"workers_dev": true,
	"preview_urls": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"compatibility_date": "2026-06-13",
	"routes": [
		{
			"pattern": "cy3.cc.cd",
			"zone_name": "cy3.cc.cd",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		},
		{
			"pattern": "www.cy3.cc.cd",
			"zone_name": "cy3.cc.cd",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	],
	"vars": {
		"DNSHE_API_KEY": "cfsd_e3e7df615a4499ecbe44170636766b42",
		"DNSHE_SUBDOMAIN_ID": "1544844327"
	},
	"d1_databases": [
		{
			"binding": "db",
			"database_name": "cy3",
			"database_id": "4f4f7505-ad2f-4a85-ae23-00a5012e2b6f"
		}
	],
	"queues": {
		"producers": [
			{
				"queue": "q",
				"binding": "queue"
			}
		],
		"consumers": [
			{
				"queue": "q",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 3
			}
		]
	},
	"ratelimits": [
		{
			"name": "rateLimiter",
			"namespace_id": "1",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"issues": {
			"enabled": false
		},
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"assets": {
		"directory": "./public",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"previews": {
		"vars": {
			"DNSHE_API_KEY": "cfsd_e3e7df615a4499ecbe44170636766b42",
			"DNSHE_SUBDOMAIN_ID": "1544844327"
		},
		"d1_databases": [
			{
				"binding": "db",
				"database_name": "cy3-preview",
				"database_id": "2c9beda6-6590-41de-b11e-41b8c9417ca8"
			}
		],
		"queues": {
			"producers": [
				{
					"queue": "q-preview",
					"binding": "queue"
				}
			]
		},
		"ratelimits": [
			{
				"name": "rateLimiter",
				"namespace_id": "1",
				"simple": {
					"limit": 5,
					"period": 60
				}
			}
		],
		"observability": {
			"enabled": true,
			"head_sampling_rate": 1,
			"issues": {
				"enabled": false
			},
			"logs": {
				"enabled": true,
				"head_sampling_rate": 1,
				"invocation_logs": true,
				"persist": true
			},
			"traces": {
				"enabled": true,
				"head_sampling_rate": 1,
				"persist": true
			}
		}
	}
}